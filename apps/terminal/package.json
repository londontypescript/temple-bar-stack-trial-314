{
  "name": "@trial/terminal",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "start:source": "tsx src/main.tsx",
    "build": "esbuild src/main.tsx --bundle --platform=node --format=esm --external:ink --external:react --external:react/jsx-runtime --outfile=dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@trial/shared": "workspace:*",
    "react": "catalog:",
    "ink": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "24.19.0",
    "@types/react": "catalog:"
  }
}
