{
  "name": "temple-bar-stack-trial-314",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint . && pnpm -r run lint",
    "format:check": "prettier --check . && pnpm -r run format:check",
    "test": "vitest run --config vitest.root.config.ts && pnpm -r run test",
    "build": "pnpm --filter @trial/web build && pnpm --filter @trial/scene build && pnpm --filter @trial/terminal build && pnpm --filter @trial/desktop build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "knip": "knip --include files,exports,types --no-progress",
    "knip:entry-exports": "knip --include files,exports,types --include-entry-exports --no-progress",
    "prepare": "temple-bar hook install",
    "gate": "temple-bar gate",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@londontypescript/temple-bar": "0.0.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.0",
    "vitest": "catalog:"
  }
}
